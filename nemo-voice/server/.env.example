# Required: Google AI API key for Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Model and voice settings
MODEL=gemini-2.5-flash-preview-native-audio-dialog
VOICE_NAME=Zephyr
VOICE_PORT=3002

# Optional: Google Maps MCP
GOOGLE_MAPS_API_KEY=

# Nemo scripts and OAuth (auto-resolved if running from claudir-main/)
# NEMO_SCRIPTS_DIR=/opt/nemo/scripts
# NEMO_OAUTH_DB=/opt/nemo/data/prod/oauth_tokens.db
