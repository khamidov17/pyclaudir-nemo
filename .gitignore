# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Project data (runtime)
data/
!data/memories/.gitkeep

# Env
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
*.bak

# Project-specific prompt (not shipped with open-source pyclaudir)
prompts/project.md

# Local plugin config — operator copies plugins.json.example on setup,
# then customises. Not tracked so different deployments don't fight
# over the file.
plugins.json

# Local access policy — operator copies access.json.example on setup,
# then customises (DM policy, allowed users/chats). Lives at repo root
# alongside plugins.json so both operator-edited config files sit
# together; not tracked so deployments don't fight over the file.
access.json

# Editors
.vscode/
.idea/
.DS_Store

# Flutter / Android generated output
nemo-app/.dart_tool/
nemo-app/.flutter-plugins
nemo-app/.flutter-plugins-dependencies
nemo-app/build/
nemo-app/android/.gradle/
nemo-app/android/local.properties
nemo-app/android/app/*.apk
nemo-app/android/app/*.aab
nemo-app/ios/Flutter/Generated.xcconfig
nemo-app/ios/Flutter/flutter_export_environment.sh
nemo-app/ios/Flutter/ephemeral/

# Node / web generated output
node_modules/
dist/
build/
